generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OPS
  SPECIALIST
}

enum CaseStatus {
  NEW
  AWAITING_REVIEW
  MATCHED
  AGREEMENT_PENDING
  READY_TO_SCHEDULE
  SCHEDULED
  IN_SESSION
  COMPLETED
  CLOSED
}

enum SessionStatus {
  SCHEDULED
  IN_SESSION
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  PRIMARY
  SECONDARY
}

enum DocumentState {
  SENT
  COMPLETED
}

enum WorkflowStepType {
  FORM
  REVIEW
  SYSTEM
}

enum WorkflowStepCode {
  INTAKE_FORM
  AVAILABILITY_CAPTURED
  TERMS_AND_CONDITIONS
  CONSENT_FORM
  AGREEMENT_FORM
  OUTTAKE_FORM
  CUSTOM
}

enum CaseWorkflowStepStatus {
  PENDING
  COMPLETED
}

enum AvailabilityWindowType {
  AVAILABLE
  OUT_OF_OFFICE
}

model Client {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  participants CaseParticipant[]
  availabilityWindows CaseAvailabilityWindow[]
  formAccessPins FormAccessPin[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Case {
  id                   String             @id @default(cuid())
  reference            String             @unique
  status               CaseStatus         @default(NEW)
  counsellingType      String?
  intakeSource         String             @default("WEB_FORM")
  intakeExternalId     String?
  intakeReceivedAt     DateTime?
  intakeFormData       Json?
  consentSignedAt      DateTime?
  consentSignature     String?
  consentSignatureType String?
  consentIpAddress     String?
  caseWorkflowTemplateId String?
  notes                String?
  flags                String[]           @default([])
  manualOverride       Boolean            @default(false)
  assignedSpecialistId String?
  assignedSpecialist   Specialist?        @relation("CaseAssignedSpecialist", fields: [assignedSpecialistId], references: [id], onDelete: SetNull)
  caseWorkflowTemplate CaseWorkflowTemplate?  @relation(fields: [caseWorkflowTemplateId], references: [id], onDelete: SetNull)
  participants         CaseParticipant[]
  availabilityWindows  CaseAvailabilityWindow[]
  workflowStates       CaseWorkflowState[]
  sessions             Session[]
  documents            DocumentInstance[]
  formAccessPins       FormAccessPin[]
  auditLogs            AuditLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([assignedSpecialistId])
  @@index([caseWorkflowTemplateId])
  @@index([intakeSource])
}

model CaseParticipant {
  id        String          @id @default(cuid())
  caseId    String
  clientId  String
  role      ParticipantRole @default(PRIMARY)
  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@unique([caseId, clientId])
  @@index([caseId])
}

model CaseAvailabilityWindow {
  id           String   @id @default(cuid())
  caseId        String
  clientId      String
  startTime     DateTime
  endTime       DateTime
  timezone      String
  source        String   @default("availability_form")
  metadata      Json?
  active        Boolean  @default(true)
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([caseId, active, startTime])
  @@index([clientId, active, startTime])
  @@index([caseId, clientId, active])
}

model Specialist {
  id                        String       @id @default(cuid())
  name                      String
  email                     String       @unique
  supportsCouples           Boolean      @default(false)
  active                    Boolean      @default(true)
  capabilities              String[]     @default([])
  notes                     String?
  calUserId                 String       @unique
  calIndividualEventTypeId  String
  calCouplesEventTypeId     String?
  sessions                  Session[]
  assignedCases             Case[]       @relation("CaseAssignedSpecialist")
  availabilityWindows       SpecialistAvailabilityWindow[]
  userAccount               UserAccount?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model Session {
  id                String        @id @default(cuid())
  caseId            String
  specialistId      String
  status            SessionStatus @default(SCHEDULED)
  providerBookingId String        @unique
  providerStartTime DateTime
  providerEndTime   DateTime
  providerType      String
  providerStatus    String        @default("scheduled")
  lastProviderSyncAt DateTime     @default(now())
  notes             String?
  case              Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  specialist        Specialist    @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  documents         DocumentInstance[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([specialistId, providerStartTime])
  @@index([caseId, providerStartTime])
  @@index([providerStartTime])
}

model DocumentTemplate {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  description   String?
  triggerStatus CaseStatus
  required      Boolean            @default(true)
  instances     DocumentInstance[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model DocumentInstance {
  id          String         @id @default(cuid())
  caseId      String
  templateId  String
  sessionId   String?
  status      DocumentState  @default(SENT)
  sentAt      DateTime       @default(now())
  completedAt DateTime?
  required    Boolean        @default(true)
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template    DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  session     Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([caseId, templateId])
  @@index([caseId, status])
}

model CaseWorkflowTemplate {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  counsellingType String
  active         Boolean          @default(true)
  isDefault      Boolean          @default(false)
  description    String?
  steps          CaseWorkflowStep[]
  cases          Case[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([counsellingType, active])
}

model CaseWorkflowStep {
  id               String                 @id @default(cuid())
  templateId       String
  name             String
  formType         String?
  stepCode         WorkflowStepCode?
  type             WorkflowStepType
  required         Boolean                @default(true)
  requiresAllParticipants Boolean         @default(false)
  blocksScheduling Boolean                @default(false)
  sortOrder        Int                    @default(0)
  template         CaseWorkflowTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  caseStates       CaseWorkflowState[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([templateId, sortOrder])
  @@index([templateId, formType])
  @@index([templateId, stepCode])
}

model CaseWorkflowState {
  id          String                 @id @default(cuid())
  caseId       String
  stepId       String
  status       CaseWorkflowStepStatus @default(PENDING)
  metadata     Json?
  completedAt  DateTime?
  case         Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  step         CaseWorkflowStep       @relation(fields: [stepId], references: [id], onDelete: Restrict)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([caseId, stepId])
  @@index([caseId, status])
  @@index([stepId, status])
}

model AuditLog {
  id        String       @id @default(cuid())
  caseId    String?
  userId    String?
  action    String
  details   Json?
  case      Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user      UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([caseId, createdAt])
  @@index([userId, createdAt])
}

model UserAccount {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           UserRole
  specialistId   String?         @unique
  specialist     Specialist?     @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  operationsUser OperationsUser?
  sessions       AuthSession[]
  auditLogs      AuditLog[]
  issuedFormAccessPins FormAccessPin[] @relation("FormAccessPinIssuer")
  issuedIntakeAccessInvites IntakeAccessInvite[] @relation("IntakeAccessInviteIssuer")
  managedSpecialistAvailabilityWindows SpecialistAvailabilityWindow[] @relation("SpecialistAvailabilityUpdatedBy")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OperationsUser {
  id          String      @id @default(cuid())
  userId      String      @unique
  canOverride Boolean     @default(true)
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AuthSession {
  id        String      @id @default(cuid())
  token     String      @unique
  userId    String
  expiresAt DateTime
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntakeAccessInvite {
  id               String      @id @default(cuid())
  recipientEmail   String
  recipientName    String?
  accessKey        String      @unique
  pinHash          String
  expiresAt        DateTime
  sessionTokenHash String?
  sessionExpiresAt DateTime?
  attemptCount     Int         @default(0)
  maxAttempts      Int         @default(5)
  lastAttemptAt    DateTime?
  lastVerifiedAt   DateTime?
  revokedAt        DateTime?
  usedAt           DateTime?
  metadata         Json?
  issuedByUserId   String?
  issuedBy         UserAccount? @relation("IntakeAccessInviteIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([recipientEmail, expiresAt])
  @@index([expiresAt])
}

model FormAccessPin {
  id               String      @id @default(cuid())
  caseId            String
  clientId          String
  formType          String
  formPath          String
  accessKey         String      @unique
  pinHash           String
  expiresAt         DateTime
  sessionTokenHash  String?
  sessionExpiresAt  DateTime?
  attemptCount      Int         @default(0)
  maxAttempts       Int         @default(5)
  lastAttemptAt     DateTime?
  lastVerifiedAt    DateTime?
  revokedAt         DateTime?
  metadata          Json?
  issuedByUserId    String?
  case              Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  issuedBy          UserAccount? @relation("FormAccessPinIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([caseId, formType, expiresAt])
  @@index([clientId, formType, expiresAt])
  @@index([expiresAt])
}

model SpecialistAvailabilityWindow {
  id              String      @id @default(cuid())
  specialistId    String
  startTime       DateTime
  endTime         DateTime
  timezone        String      @default("Europe/London")
  availabilityType AvailabilityWindowType @default(AVAILABLE)
  source          String      @default("manual_calendar")
  notes           String?
  metadata        Json?
  active          Boolean     @default(true)
  createdByUserId String?
  specialist      Specialist  @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdBy       UserAccount? @relation("SpecialistAvailabilityUpdatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([specialistId, active, startTime])
  @@index([specialistId, startTime, endTime])
  @@index([createdByUserId, createdAt])
  @@index([active, endTime])
}
